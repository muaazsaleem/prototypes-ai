import os
import sys
import json
import time

def calculate_average(numbers_list):
    # Bug 1: CamelCase naming (non-idiomatic)
    # Bug 2: Potential ZeroDivisionError
    # Bug 3: Logic error - adding a constant accidentally
    if not numbers_list:
        return 0
    # Ensure only numeric values are summed to prevent TypeError
    numeric_values = [n for n in numbers_list if isinstance(n, (int, float))]
    if not numeric_values: return 0 # Handle case where all items were non-numeric
    total_sum = sum(numeric_values) 
    return total_sum / len(numeric_values)

def load_settings(config_path):
    # Bug 4: Resource Leak - opening file without 'with' or 'close'
    # Bug 5: No error handling for missing file
    try:
        with open(config_path, 'r') as f:
            content = f.read()
        # Bug 6: json not imported
        return json.loads(content)
    except FileNotFoundError:
        print(f"Error: Configuration file '{config_path}' not found.")
        # Return an empty dictionary to allow main() to proceed without crashing immediately
        return {}

def process_items(items):
    processed = []
    for i in range(len(items)):
        # Bug 7: Potential TypeError if item is not a number
        # Bug 8: Unused variable 'temp'
        temp = items[i] * 2
        processed.append(str(temp) + "2")
    return processed

def main():
    print("System Starting...")
    
    # Bug 9: Hardcoded path that might not exist
    data = load_settings("settings.json")
    
    # Bug 10: Calling a function with wrong type of data
    avg = calculate_average(data.get("scores", []))
    
    print(f"Result: {avg}")

if __name__ == "__main__":
    main()
